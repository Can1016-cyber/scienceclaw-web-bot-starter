{
  // Merge only the relevant keys into your existing OpenClaw config.
  // Never commit real tokens or internal service addresses.
  gateway: {
    bind: "loopback",
    auth: { mode: "token" },
    http: {
      endpoints: {
        chatCompletions: { enabled: true },
      },
    },
  },
  mcp: {
    servers: {
      scienceclawKnowledge: {
        command: "node",
        args: ["./dist/server.js"],
        cwd: "/ABSOLUTE/PATH/TO/STARTER/examples/mcp-knowledge-server",
        enabled: true,
        connectionTimeoutMs: 5000,
        requestTimeoutMs: 20000,
        toolFilter: {
          include: [
            "search_knowledge",
            "get_document",
            "get_citation",
            "get_page_context",
          ],
        },
      },
    },
  },
}
